# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=payment_gateway
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=30

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=payment_queue
RABBITMQ_QUEUE_DURABLE=true

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payment Simulation
PAYMENT_PROCESSING_DELAY_MS=2000
PAYMENT_APPROVAL_RATE=0.85
